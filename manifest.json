{
  "manifest_version": 3,
  "name": "Roe: Secure What Your Agent Sees",
  "version": "1.0.0",
  "description": "Finds and removes hidden prompt injections in pages, email, GitHub and files, and shows what your AI agent can access.",
  "minimum_chrome_version": "110",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "offscreen",
    "downloads",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "edition.js",
        "detector.js",
        "sinks.js",
        "surfaces.js",
        "exposure.js",
        "ai-sites.js",
        "content.js",
        "guard.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Roe",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "host_permissions": [
    "https://api.github.com/*",
    "http://*/*",
    "https://*/*",
    "file:///*"
  ]
}